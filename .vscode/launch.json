{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug with Homebrew GDB",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/mnist_app",
      "args": [],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/opt/homebrew/bin/gdb",
      "preLaunchTask": "Build with Homebrew GCC",
      "setupCommands": [
        {
          "description": "Enable GDB pretty printing",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ]
}